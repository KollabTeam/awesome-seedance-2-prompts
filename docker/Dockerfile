# syntax=docker/dockerfile:1.7
# ========== build stage ==========
# landing-pages 镜像负责独立营销落地页的 Next.js standalone 构建和运行。
# 依赖层只读取 lockfile/package.json，并复用 BuildKit pnpm store 来缩短重复发布。
FROM node:20-alpine AS builder

WORKDIR /app

RUN --mount=type=cache,id=landing-pages-npm-cache,target=/root/.npm \
    npm install -g pnpm@10

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY patches/ ./patches/
COPY packages/i18n/package.json ./packages/i18n/
COPY apps/landing-pages/package.json ./apps/landing-pages/

RUN --mount=type=cache,id=landing-pages-pnpm-store,target=/pnpm/store \
    pnpm config set registry https://registry.npmmirror.com && \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile --filter seeds-landing-pages...

COPY packages/i18n/ ./packages/i18n/
COPY apps/landing-pages/ ./apps/landing-pages/

WORKDIR /app/apps/landing-pages
ARG NEXT_PUBLIC_ASSET_PREFIX=/landing-pages-static
ARG VITE_APP_ENV=production
ARG NEXT_PUBLIC_PROXY_TARGET=
ARG NEXT_PUBLIC_GTM_ID=
ARG NEXT_PUBLIC_GA_MEASUREMENT_ID=
ARG NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=
ARG NEXT_PUBLIC_CLARITY_PROJECT_ID=
ARG NEXT_PUBLIC_FIREBASE_API_KEY=
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID=
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
ARG NEXT_PUBLIC_FIREBASE_APP_ID=
ARG NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
ARG NEXT_PUBLIC_MIXPANEL_TOKEN=
ARG NEXT_PUBLIC_MIXPANEL_REPLAY_PERCENT=10
ENV NEXT_PUBLIC_ASSET_PREFIX=${NEXT_PUBLIC_ASSET_PREFIX}
ENV VITE_APP_ENV=${VITE_APP_ENV}
ENV NEXT_PUBLIC_PROXY_TARGET=${NEXT_PUBLIC_PROXY_TARGET}
ENV NEXT_PUBLIC_GTM_ID=${NEXT_PUBLIC_GTM_ID}
ENV NEXT_PUBLIC_GA_MEASUREMENT_ID=${NEXT_PUBLIC_GA_MEASUREMENT_ID}
ENV NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=${NEXT_PUBLIC_AHREFS_ANALYTICS_KEY}
ENV NEXT_PUBLIC_CLARITY_PROJECT_ID=${NEXT_PUBLIC_CLARITY_PROJECT_ID}
ENV NEXT_PUBLIC_FIREBASE_API_KEY=${NEXT_PUBLIC_FIREBASE_API_KEY}
ENV NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=${NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN}
ENV NEXT_PUBLIC_FIREBASE_PROJECT_ID=${NEXT_PUBLIC_FIREBASE_PROJECT_ID}
ENV NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=${NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET}
ENV NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=${NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID}
ENV NEXT_PUBLIC_FIREBASE_APP_ID=${NEXT_PUBLIC_FIREBASE_APP_ID}
ENV NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=${NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID}
ENV NEXT_PUBLIC_MIXPANEL_TOKEN=${NEXT_PUBLIC_MIXPANEL_TOKEN}
ENV NEXT_PUBLIC_MIXPANEL_REPLAY_PERCENT=${NEXT_PUBLIC_MIXPANEL_REPLAY_PERCENT}
RUN pnpm build

# ========== production stage ==========
FROM node:20-alpine AS production

WORKDIR /app

ARG NEXT_PUBLIC_ASSET_PREFIX=/landing-pages-static
ARG VITE_APP_ENV=production
ARG NEXT_PUBLIC_PROXY_TARGET=
ARG NEXT_PUBLIC_GTM_ID=
ARG NEXT_PUBLIC_GA_MEASUREMENT_ID=
ARG NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=
ARG NEXT_PUBLIC_CLARITY_PROJECT_ID=
ARG NEXT_PUBLIC_FIREBASE_API_KEY=
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID=
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
ARG NEXT_PUBLIC_FIREBASE_APP_ID=
ARG NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
ARG NEXT_PUBLIC_MIXPANEL_TOKEN=
ARG NEXT_PUBLIC_MIXPANEL_REPLAY_PERCENT=10
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV NEXT_PUBLIC_ASSET_PREFIX=${NEXT_PUBLIC_ASSET_PREFIX}
ENV VITE_APP_ENV=${VITE_APP_ENV}
ENV NEXT_PUBLIC_PROXY_TARGET=${NEXT_PUBLIC_PROXY_TARGET}
ENV NEXT_PUBLIC_GTM_ID=${NEXT_PUBLIC_GTM_ID}
ENV NEXT_PUBLIC_GA_MEASUREMENT_ID=${NEXT_PUBLIC_GA_MEASUREMENT_ID}
ENV NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=${NEXT_PUBLIC_AHREFS_ANALYTICS_KEY}
ENV NEXT_PUBLIC_CLARITY_PROJECT_ID=${NEXT_PUBLIC_CLARITY_PROJECT_ID}
ENV NEXT_PUBLIC_FIREBASE_API_KEY=${NEXT_PUBLIC_FIREBASE_API_KEY}
ENV NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=${NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN}
ENV NEXT_PUBLIC_FIREBASE_PROJECT_ID=${NEXT_PUBLIC_FIREBASE_PROJECT_ID}
ENV NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=${NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET}
ENV NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=${NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID}
ENV NEXT_PUBLIC_FIREBASE_APP_ID=${NEXT_PUBLIC_FIREBASE_APP_ID}
ENV NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=${NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID}
ENV NEXT_PUBLIC_MIXPANEL_TOKEN=${NEXT_PUBLIC_MIXPANEL_TOKEN}
ENV NEXT_PUBLIC_MIXPANEL_REPLAY_PERCENT=${NEXT_PUBLIC_MIXPANEL_REPLAY_PERCENT}

COPY --from=builder /app/apps/landing-pages/.next/standalone ./
COPY --from=builder /app/apps/landing-pages/.next/static ./apps/landing-pages/.next/static
COPY --from=builder /app/apps/landing-pages/public ./apps/landing-pages/public

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:3000/api/health || exit 1

CMD ["node", "apps/landing-pages/server.js"]
