# Copy this file to .env.local for local development.
# This template intentionally contains placeholders only. Do not commit real API keys, tokens, passwords, or private URLs.

# Runtime
VITE_APP_ENV=local
NEXT_PUBLIC_ASSET_PREFIX=/landing-pages-static
LANDING_PROMPTS_DEV_PROXY_URL=

# Public analytics integrations (optional; public browser tokens only)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_MIXPANEL_REPLAY_PERCENT=
NEXT_PUBLIC_PROXY_TARGET=

# Notion sync source
LANDING_PAGES_NOTION_API_KEY=
NOTION_SEEDANCE_PROMPTS_DATABASE_ID=
LANDING_PROMPTS_NOTION_RETRY_ATTEMPTS=
LANDING_PROMPTS_NOTION_RETRY_DELAY_MS=
NOTION_GPT_IMAGE_PROMPTS_TAGS_PROPERTY=

# Prompt read-model database
LANDING_PROMPTS_DB_HOST=
LANDING_PROMPTS_DB_PORT=5432
LANDING_PROMPTS_DB_USERNAME=
LANDING_PROMPTS_DB_PASSWORD=
LANDING_PROMPTS_DB_DATABASE=
LANDING_PROMPTS_DB_SSL=true
LANDING_PROMPTS_DB_POOL_MAX=4

# Media mirror storage
LANDING_PROMPTS_S3_BUCKET=
LANDING_PROMPTS_S3_REGION=ap-northeast-1
LANDING_PROMPTS_CDN_BASE_URL=
LANDING_PROMPTS_VIDEO_ASSET_MAX_BYTES=
LANDING_PROMPTS_CLOUDFLARE_STREAM_ACCOUNT_ID=
LANDING_PROMPTS_CLOUDFLARE_STREAM_API_TOKEN=

# Internal sync endpoint
LANDING_PROMPTS_SYNC_ENABLED=false
LANDING_PROMPTS_INTERNAL_TOKEN=
